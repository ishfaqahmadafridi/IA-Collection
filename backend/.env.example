# Export these values in the backend process environment; this example is not auto-loaded.
DJANGO_ENV=development
DJANGO_DEBUG=true
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
# sqlite:///db.sqlite3 is relative to backend/. Absolute example: sqlite:////srv/store/db.sqlite3
DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
# Production requires an explicit shared cache. Run python manage.py createcachetable for DatabaseCache.
CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
CACHE_LOCATION=api_rate_limits
# Set DJANGO_ENV=production and configure HTTPS/proxy trust before a public deployment.
TRUST_PROXY_HEADERS=false
# Zero for direct connections; set to the exact number of trusted reverse proxies.
TRUSTED_PROXY_COUNT=0
# Enable these only after verifying every subdomain and the preload requirements.
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Optional Decart live-video garment replacement. Export in the backend process.
DECART_API_KEY=
# Canonical frontend origins, e.g. https://shop.example.com (no trailing slash).
DECART_ALLOWED_ORIGINS=
DECART_MAX_SESSION_SECONDS=120
LIVE_TRYON_RATE=3/hour
